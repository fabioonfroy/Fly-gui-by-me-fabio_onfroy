local Flying = false
local FlySpeed = 1
local Multiplier = 70

-- Ajuste fino de altura
btnUp.MouseButton1Click:Connect(function()
    local char = lp.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = char.HumanoidRootPart.CFrame * CFrame.new(0, 0.8, 0)
    end
end)

btnDown.MouseButton1Click:Connect(function()
    local char = lp.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = char.HumanoidRootPart.CFrame * CFrame.new(0, -0.8, 0)
    end
end)

btnPlus.MouseButton1Click:Connect(function()
    FlySpeed = FlySpeed + 1
    SpeedLabel.Text = tostring(FlySpeed)
end)

btnMinus.MouseButton1Click:Connect(function()
    if FlySpeed > 1 then
        FlySpeed = FlySpeed - 1
        SpeedLabel.Text = tostring(FlySpeed)
    end
end)

btnFly.MouseButton1Click:Connect(function()
    Flying = not Flying
    local char = lp.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    
    if Flying then
        btnFly.TextColor3 = Color3.fromRGB(0, 255, 0)
        local bv = Instance.new("BodyVelocity", hrp)
        bv.Name = "FlyVel"
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        
        local bg = Instance.new("BodyGyro", hrp)
        bg.Name = "FlyGyro"
        bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bg.P = 50000 
        
        hum.PlatformStand = true

        task.spawn(function()
            while Flying do
                local cam = workspace.CurrentCamera
                local moveDir = hum.MoveDirection
                bg.CFrame = cam.CFrame
                
                if moveDir.Magnitude > 0 then
                    local look = cam.CFrame.LookVector
                    local right = cam.CFrame.RightVector
                    local forwardVec = Vector3.new(look.X, look.Y, look.Z)
                    local rightVec = Vector3.new(right.X, 0, right.Z).Unit
                    local horizontalDir = moveDir:Dot(Vector3.new(right.X, 0, right.Z).Unit)
                    local forwardDir = moveDir:Dot(Vector3.new(look.X, 0, look.Z).Unit)
                    local finalVec = (forwardVec * forwardDir) + (rightVec * horizontalDir)
                    bv.Velocity = finalVec.Unit * (FlySpeed * Multiplier)
                else
                    bv.Velocity = Vector3.new(0, 0.1, 0)
                end
                task.wait()
            end
            if hrp:FindFirstChild("FlyVel") then hrp.FlyVel:Destroy() end
            if hrp:FindFirstChild("FlyGyro") then hrp.FlyGyro:Destroy() end
            hum.PlatformStand = false
            btnFly.TextColor3 = Color3.fromRGB(255, 255, 255)
        end)
    else
        btnFly.TextColor3 = Color3.fromRGB(255, 255, 255)
    end
end)
